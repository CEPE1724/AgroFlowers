---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { SaleDetailView } from '@/components/sales/SaleDetailView';

const { id } = Astro.params;
const saleId = Number(id);
---

<DashboardLayout
  title="Detalle de venta"
  pageTitle="Detalle de venta"
  breadcrumbs={[{ label: 'Ventas', href: '/sales' }, { label: 'Detalle' }]}
  requiredPermission="SALES_VIEW"
>
  <SaleDetailView client:load saleId={saleId} />
</DashboardLayout>
