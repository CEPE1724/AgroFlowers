---
import AuthLayout from '@/layouts/AuthLayout.astro';
import { RegisterForm } from '@/components/auth/RegisterForm';
---

<AuthLayout title="Crear cuenta">
  <div class="grid w-full max-w-5xl grid-cols-1 overflow-hidden rounded-2xl shadow-soft lg:grid-cols-2">
    <div class="relative hidden flex-col justify-between overflow-hidden bg-gradient-to-br from-primary-700 via-primary-600 to-accent-700 p-10 text-white lg:flex">
      <div
        class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/10 blur-2xl"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-24 -left-10 h-72 w-72 rounded-full bg-accent-500/20 blur-3xl"
      >
      </div>

      <div class="relative z-10 flex items-center gap-2">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/15 backdrop-blur">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none">
            <path
              d="M12 3c1.5 0 2.5 1.3 2.5 2.8 0 1-.5 1.9-1.2 2.5.7-.4 1.7-.6 2.6-.3 1.5.5 2.3 2.1 1.9 3.6-.4 1.5-1.9 2.4-3.4 2.1.9.6 1.5 1.7 1.3 2.9-.3 1.5-1.8 2.5-3.3 2.2-1-.2-1.8-.9-2.1-1.8-.3.9-1.1 1.6-2.1 1.8-1.5.3-3-.7-3.3-2.2-.2-1.2.4-2.3 1.3-2.9-1.5.3-3-.6-3.4-2.1-.4-1.5.4-3.1 1.9-3.6.9-.3 1.9-.1 2.6.3-.7-.6-1.2-1.5-1.2-2.5C9.5 4.3 10.5 3 12 3z"
              fill="white"></path>
            <circle cx="12" cy="12" r="1.6" fill="#e560ac"></circle>
          </svg>
        </div>
        <span class="text-lg font-bold">AgroFlowers AI</span>
      </div>

      <div class="relative z-10 space-y-4">
        <h1 class="text-3xl font-bold leading-tight">Únete a la operación</h1>
        <p class="text-sm text-primary-50/90">
          Crea tu cuenta de Operador para registrar compras, embarques y costos desde el primer día.
        </p>
      </div>

      <p class="relative z-10 text-xs text-primary-50/70">
        Autenticación centralizada mediante Keycloak (OAuth2 / OIDC) · Entorno de demostración
      </p>
    </div>

    <div class="flex items-center justify-center bg-surface-light p-6 dark:bg-surface-dark sm:p-10">
      <div class="w-full max-w-sm">
        <div class="mb-6 text-center lg:hidden">
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-primary-600 text-white">
            <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none">
              <path
                d="M12 3c1.5 0 2.5 1.3 2.5 2.8 0 1-.5 1.9-1.2 2.5.7-.4 1.7-.6 2.6-.3 1.5.5 2.3 2.1 1.9 3.6-.4 1.5-1.9 2.4-3.4 2.1.9.6 1.5 1.7 1.3 2.9-.3 1.5-1.8 2.5-3.3 2.2-1-.2-1.8-.9-2.1-1.8-.3.9-1.1 1.6-2.1 1.8-1.5.3-3-.7-3.3-2.2-.2-1.2.4-2.3 1.3-2.9-1.5.3-3-.6-3.4-2.1-.4-1.5.4-3.1 1.9-3.6.9-.3 1.9-.1 2.6.3-.7-.6-1.2-1.5-1.2-2.5C9.5 4.3 10.5 3 12 3z"
                fill="white"></path>
              <circle cx="12" cy="12" r="1.6" fill="#e560ac"></circle>
            </svg>
          </div>
          <h1 class="text-xl font-bold text-primary-900 dark:text-primary-50">AgroFlowers AI</h1>
          <p class="text-sm text-gray-500 dark:text-primary-400">Crea tu cuenta de Operador</p>
        </div>

        <RegisterForm client:load />
      </div>
    </div>
  </div>
</AuthLayout>
